# ─── Server ──────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ─── MongoDB Atlas ────────────────────────────────────────────
# Get this from: https://cloud.mongodb.com
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/petcare?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────────
# Use a long random string — never use a short or obvious secret
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────
# Allowed origins for CORS (comma-separated if multiple)
# In production, set this to your frontend domain or leave * for mobile apps
CORS_ORIGIN=*

